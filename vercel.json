{
  "crons": [
    { "path": "/api/sync-dayoffs", "schedule": "0 4 1,2 * *" },
    { "path": "/api/weekly-report", "schedule": "30 22 * * 0" },
    { "path": "/api/push-daily", "schedule": "0 0 * * *" },
    { "path": "/api/remind-am", "schedule": "0 0 * * *" },
    { "path": "/api/remind-pm", "schedule": "0 9 * * *" },
    { "path": "/api/purge-guests", "schedule": "0 18 * * *" },
    { "path": "/api/remind-now", "schedule": "* * * * *" }
  ],
  "rewrites": [
    { "source": "/intro", "destination": "/landing.html" },
    { "source": "/r/:slug", "destination": "/lp/book.html" },
    { "source": "/b/:token", "destination": "/lp/book.html" }
  ]
}
